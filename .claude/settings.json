{
  "@schema": "https://www.schemastore.org/claude-code-settings.json",
  "statusLine": {
    "type": "command",
    "command": ".claude/status-line.sh",
    "padding": 0
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(grep:*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "fileExclusions": [
    "**/build/**",
    "**/.*/**",
    "**/.gradle/**",
    "**/node_modules/**",
    "**/*.iml",
    "**/local.properties",
    "**/google-services.json",
    "**/composeApp/build/compose_compiler/**"
  ],
  "codeStyle": {
    "kotlinIndentSize": 4,
    "preferImmutableCollections": true
  },
  "project": {
    "type": "kotlin-multiplatform-mobile",
    "buildTool": "gradle",
    "mainBranch": "dev"
  }
}
